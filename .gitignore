# OS junk
.DS_Store

# Zsh state/history
zsh/zsh/.zcompdump*
zsh/zsh/.zsh_history

# Karabiner backups
karabiner/karabiner/automatic_backups/

# GitHub CLI auth (contains tokens)
gh/gh/hosts.yml

# Neovim generated files
nvim/nvim/spell/*.spl

# Lazygit state (runtime, not config)
lazygit/lazygit/state.yml

# Optional: plugin/vendor dirs
zsh/zsh/zsh-completions/
zsh/zsh/zsh-syntax-highlighting/

# tmux plugins (managed by tpm)
tmux/tmux/plugins/

# Machine-local env vars (personal/work, not shared)
zsh/zsh/.zshenv.local

# Raycast extensions and AI data (contains downloaded extensions and possibly API keys)
raycast/raycast/extensions/
raycast/raycast/ai/
